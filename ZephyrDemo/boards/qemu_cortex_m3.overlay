/ {
	dfm_retained_memory: memory@20008000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x20008000 0x8000>;
		ranges = <0x0 0x20008000 0x8000>;
		zephyr,memory-region = "DfmRetained";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <1>;

		retainedmem0: retainedmem {
			compatible = "zephyr,retained-ram";
			status = "okay";
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			retention0: retention@0 {
				compatible = "zephyr,retention";
				status = "okay";
				reg = <0x0 0x8000>;
				prefix = [44 46 4d 52];
			};
		};
	};

    chosen {
        zephyr,console = &uart0;
    };
};

&sram0 {
	reg = <0x20000000 0x8000>;
};

&uart0 {
    current-speed = <460800>;
    status = "okay";
};

