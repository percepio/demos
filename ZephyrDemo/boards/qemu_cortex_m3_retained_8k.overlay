/* Reserve the upper 8 KiB of SRAM for the small DFM retained test variant.
 * This intentionally undersized suffix overlay is not loaded automatically.
 * The m3_retained_8k test selects it with:
 *   -DEXTRA_DTC_OVERLAY_FILE=boards/qemu_cortex_m3_retained_8k.overlay
 * Do not combine it with another overlay that reserves the same SRAM range.
 */

/ {
	dfm_retained_memory: memory@2000e000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2000e000 0x2000>;
		ranges = <0x0 0x2000e000 0x2000>;
		zephyr,memory-region = "DfmRetained";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <1>;

		retainedmem0: retainedmem {
			compatible = "zephyr,retained-ram";
			status = "okay";
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			retention0: retention@0 {
				compatible = "zephyr,retention";
				status = "okay";
				reg = <0x0 0x2000>;
				prefix = [44 46 4d 52];
				checksum = <0>;
			};
		};
	};
};

&sram0 {
	reg = <0x20000000 0xe000>;
};
