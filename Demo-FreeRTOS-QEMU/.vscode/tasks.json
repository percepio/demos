{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: build (debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CMake: clean build (debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--clean-first"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": [
        "QEMU: stop GDB server"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "QEMU: start GDB server",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\.vscode\\Invoke-QemuGdbServer.ps1",
        "-Action", "Start",
        "-BuildDirectory", "${workspaceFolder}\\build\\debug",
        "-CMakePath", "cmake",
        "-QemuWindowsRuntimePath", "${config:freertos.qemuWindowsRuntimePath}",
        "-LogPath", "${workspaceFolder}\\qemu_last_session.log",
        "-Port", "1234"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": [
        "QEMU: stop GDB server",
        "CMake: build (debug)"
      ],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "qemu",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "QEMU GDB server is listening on port 1234\\."
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 2
      }
    },
    {
      "label": "QEMU: run",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--target", "run"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH};${config:freertos.qemuWindowsRuntimePath}"
        }
      },
      "dependsOn": ["QEMU: stop GDB server", "CMake: build (debug)"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "QEMU: stop GDB server",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\.vscode\\Invoke-QemuGdbServer.ps1",
        "-Action", "Stop",
        "-BuildDirectory", "${workspaceFolder}\\build\\debug",
        "-GdbPath", "${env:USERPROFILE}\\zephyr-sdk-1.0.1\\gnu\\arm-zephyr-eabi\\bin\\arm-zephyr-eabi-gdb-py.exe",
        "-Port", "1234"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Detect: Load alerts",
      "detail": "Load this project's QEMU log and ELF file into Detect.",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "${workspaceFolder}\\load-freertos-alerts.bat"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
