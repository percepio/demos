{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FreeRTOS: last selected target (GDB)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "servertype": "external",
      "executable": "${workspaceFolder}\\build\\debug\\Demo-FreeRTOS-QEMU.elf",
      "gdbPath": "${env:USERPROFILE}\\zephyr-sdk-1.0.1\\gnu\\arm-zephyr-eabi\\bin\\arm-zephyr-eabi-gdb-py.exe",
      "armToolchainPath": "${env:USERPROFILE}\\zephyr-sdk-1.0.1\\gnu\\arm-zephyr-eabi\\bin",
      "toolchainPrefix": "arm-zephyr-eabi",
      "gdbTarget": "localhost:1234",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none",
      "preLaunchCommands": [
        "set substitute-path src .."
      ],
      "overrideLaunchCommands": [
        "source build/debug/launch.gdb"
      ],
      "overrideRestartCommands": [
        "source build/debug/reset.gdb"
      ],
      "overrideResetCommands": [
        "source build/debug/reset.gdb"
      ],
      "preLaunchTask": "Debug: start GDB server",
      "postDebugTask": "Debug: stop GDB server"
    }
  ]
}
